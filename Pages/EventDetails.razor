@page "/events/{Id:int}"
@using EventEase.Models
@inject NavigationManager NavManager

<PageTitle>@(currentEvent != null ? currentEvent.Name : "Event Details")</PageTitle>

<div class="container py-4">
    @if (isLoading)
    {
        <div class="d-flex justify-content-center align-items-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading event details...</span>
            </div>
        </div>
    }
    else if (currentEvent == null)
    {
        <div class="alert alert-warning border-0 shadow-sm p-4">
            <h4 class="alert-heading"><i class="bi bi-exclamation-triangle-fill me-2"></i>Event Not Found</h4>
            <p>Event ID <code>@Id</code> could not be found or has been deactivated.</p>
            <hr />
            <a href="/events" class="btn btn-outline-dark btn-sm">Return to Events Directory</a>
        </div>
    }
    else
    {
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/events">Events</a></li>
                <li class="breadcrumb-item active" aria-current="page">@currentEvent.Name</li>
            </ol>
        </nav>

        <div class="card shadow-sm p-4">
            <h1 class="h3 mb-2">@currentEvent.Name</h1>
            <p class="text-muted mb-2">
                <i class="bi bi-calendar3 me-1"></i> @currentEvent.Date.ToString("dddd, MMMM dd, yyyy")
            </p>
            <p class="text-muted mb-3">
                <i class="bi bi-geo-alt me-1"></i> @currentEvent.Location
            </p>
            <hr />
            <p class="lead fs-6 text-secondary">@currentEvent.Description</p>

            <div class="d-flex gap-2 mt-4">
                <a href="/events" class="btn btn-outline-secondary">Back to Events</a>
                <a href="@($"/register/{currentEvent.Id}")" class="btn btn-success">Register Now</a>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private EventItem? currentEvent;
    private bool isLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        await Task.Delay(50); // Simulates fast async lookup

        if (Id <= 0)
        {
            currentEvent = null;
        }
        else
        {
            currentEvent = new EventItem
            {
                Id = Id,
                Name = $"Verified Event #{Id}",
                Date = DateTime.Today.AddDays(Id % 60),
                Location = $"Venue Room {Id * 2}",
                Description = "Validated and secure event specification loaded dynamically."
            };
        }

        isLoading = false;
    }
}