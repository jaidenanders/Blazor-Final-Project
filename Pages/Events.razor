@page "/"
@page "/events"
@using EventEase.Models
@using EventEase.Components
@using Microsoft.AspNetCore.Components.Web.Virtualization

<PageTitle>EventEase - Browse Events</PageTitle>

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="mb-1">Upcoming Events</h2>
            <p class="text-muted small mb-0">Rendering optimized via Blazor Virtualization</p>
        </div>
        
        <div class="d-flex align-items-center gap-3">
            <input type="search" class="form-control form-control-sm" style="width: 240px;" 
                   placeholder="Filter events..." @bind="searchQuery" @bind:event="oninput" />
            
            <div class="form-check form-switch mb-0 text-nowrap">
                <input class="form-check-input" type="checkbox" id="toggleEdit" @bind="allowInlineEdit" />
                <label class="form-check-label small" for="toggleEdit">Quick Edit</label>
            </div>
        </div>
    </div>

    <!-- Virtualized Event Viewport -->
    <div class="row row-cols-1 row-cols-md-3 g-4" style="height: 700px; overflow-y: auto;">
        <Virtualize ItemsProvider="LoadEventsAsync" Context="ev" ItemSize="340" @ref="virtualizeComponent">
            <ItemContent>
                <div class="col pb-3">
                    <EventCard EventData="ev" ShowEditFields="allowInlineEdit" />
                </div>
            </ItemContent>
            <Placeholder>
                <div class="col pb-3">
                    <div class="card shadow-sm h-100 p-4 text-center text-muted">
                        <div class="spinner-border spinner-border-sm text-secondary mx-auto mb-2" role="status"></div>
                        <span>Loading event...</span>
                    </div>
                </div>
            </Placeholder>
        </Virtualize>
    </div>
</div>

@code {
    private bool allowInlineEdit = false;
    private string searchQuery = string.Empty;
    private Virtualize<EventItem>? virtualizeComponent;

    // Simulation of a large dataset (e.g., 5,000+ items)
    private static readonly List<EventItem> MasterRepository = Enumerable.Range(1, 5000).Select(i => new EventItem
    {
        Id = i,
        Name = $"Event #{i} - {(i % 2 == 0 ? "Corporate Symposium" : "Community Tech Meetup")}",
        Date = DateTime.Today.AddDays(i % 180),
        Location = $"Venue Block {((char)('A' + (i % 6)))}, Suite {i * 10}",
        Description = $"Detailed session plan and agenda overview for event number {i}."
    }).ToList();

    private async ValueTask<ItemsProviderResult<EventItem>> LoadEventsAsync(ItemsProviderRequest request)
    {
        await Task.Yield(); // Simulate minimal async pipeline overhead

        var filtered = string.IsNullOrWhiteSpace(searchQuery)
            ? MasterRepository
            : MasterRepository.Where(e => e.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                                          e.Location.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)).ToList();

        var totalCount = filtered.Count;
        var pagedItems = filtered.Skip(request.StartIndex).Take(request.Count).ToList();

        return new ItemsProviderResult<EventItem>(pagedItems, totalCount);
    }
}