@using EventEase.Models

<div class="card shadow-sm h-100" style="max-width: 22rem;">
    <div class="card-body d-flex flex-column">
        <h5 class="card-title text-truncate" title="@EventData?.Name">
            @(string.IsNullOrWhiteSpace(EventData?.Name) ? "Untitled Event" : EventData.Name)
        </h5>
        
        <h6 class="card-subtitle mb-2 text-muted">
            @(EventData?.Date == default ? "Date TBD" : EventData.Date.ToString("MMMM dd, yyyy"))
        </h6>
        
        <p class="card-text text-secondary text-truncate mb-3" title="@EventData?.Location">
            <i class="bi bi-geo-alt-fill me-1"></i>
            @(string.IsNullOrWhiteSpace(EventData?.Location) ? "Location TBD" : EventData.Location)
        </p>

        @if (ShowEditFields && EventData != null)
        {
            <div class="border-top pt-2 mt-auto">
                <EditForm Model="EventData">
                    <DataAnnotationsValidator />

                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Event Name:</label>
                        <InputText class="form-control form-control-sm" @bind-Value="EventData.Name" />
                        <ValidationMessage For="@(() => EventData.Name)" class="text-danger small" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Location:</label>
                        <InputText class="form-control form-control-sm" @bind-Value="EventData.Location" />
                        <ValidationMessage For="@(() => EventData.Location)" class="text-danger small" />
                    </div>
                </EditForm>
            </div>
        }

        <div class="d-flex gap-2 mt-auto pt-3 border-top">
            <a href="@($"/events/{EventData?.Id ?? 0}")" class="btn btn-outline-primary btn-sm flex-fill">View Details</a>
            <a href="@($"/register/{EventData?.Id ?? 0}")" class="btn btn-primary btn-sm flex-fill">Register</a>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public EventItem EventData { get; set; } = new();

    [Parameter]
    public bool ShowEditFields { get; set; } = false;
}