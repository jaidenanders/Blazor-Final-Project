@using Microsoft.AspNetCore.Components.Routing

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1, h2" />
    </Found>
    <NotFound>
        <PageTitle>Page Not Found - EventEase</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <div class="container text-center py-5">
                <div class="card border-0 shadow-sm p-5 mx-auto" style="max-width: 540px;">
                    <div class="display-1 text-danger fw-bold mb-3">404</div>
                    <h2 class="h4 mb-3">Event or Page Not Found</h2>
                    <p class="text-muted mb-4">
                        The URL you navigated to does not exist or has been relocated.
                    </p>
                    <div>
                        <a href="/events" class="btn btn-primary px-4">Return to Browse Events</a>
                    </div>
                </div>
            </div>
        </LayoutView>
    </NotFound>
</Router>